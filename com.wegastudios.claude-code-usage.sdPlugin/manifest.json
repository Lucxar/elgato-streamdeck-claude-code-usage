{
  "Name": "Claude Code Usage",
  "Version": "1.0.0.0",
  "Author": "Wega Studios",
  "URL": "https://github.com/Lucxar/elgato-streamdeck-claude-code-usage",
  "Actions": [
    {
      "Name": "Usage Tracker",
      "UUID": "com.wegastudios.claude-code-usage.tracker",
      "Icon": "imgs/actions/tracker/icon",
      "PropertyInspectorPath": "ui/inspector.html",
      "Tooltip": "Show Claude Code subscription usage on a Stream Deck + dial. Rotate to switch view (5h, weekly, Sonnet, Opus). Press to refresh.",
      "Controllers": [
        "Encoder"
      ],
      "Encoder": {
        "layout": "layouts/claude-usage.json",
        "TriggerDescription": {
          "Push": "Refresh now",
          "Touch": "Refresh now",
          "Rotate": "Switch view"
        }
      },
      "States": [
        {
          "Image": "imgs/actions/tracker/key",
          "TitleAlignment": "middle"
        }
      ]
    }
  ],
  "Category": "Claude Code Usage",
  "CategoryIcon": "imgs/plugin/category-icon",
  "CodePath": "bin/plugin.js",
  "Description": "Displays your Claude Code subscription usage limits (5-hour, weekly, Sonnet, Opus) on a Stream Deck + rotary encoder. Reads the local Claude Code session token — Claude Code must be installed and signed in. Not affiliated with Anthropic.",
  "Icon": "imgs/plugin/marketplace",
  "SDKVersion": 2,
  "Software": {
    "MinimumVersion": "6.5"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "20",
    "Debug": "disabled"
  },
  "UUID": "com.wegastudios.claude-code-usage"
}