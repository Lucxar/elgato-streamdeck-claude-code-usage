{
  "extends": "@tsconfig/node20/tsconfig.json",
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "com.wegastudios.claude-code-usage.sdPlugin/bin",
    "module": "Node16",
    "moduleResolution": "Node16",
    "target": "ES2022",
    "sourceMap": true,
    "declaration": false,
    "esModuleInterop": true,
    "strict": true,
    "noImplicitAny": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"]
}
